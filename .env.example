# Copy this file to .env and fill in the values. .env is git-ignored.

# Key that encrypts the credentials stored by n8n.
# Generate one with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Public HTTPS base URL used for the Telegram webhooks.
# start-carbu.sh fills it automatically with the Cloudflare tunnel URL.
WEBHOOK_URL=

# Optional: n8n API key (Settings > n8n API), used by start-carbu.sh to
# re-register the Telegram webhooks when the tunnel URL changes.
N8N_API_KEY=
