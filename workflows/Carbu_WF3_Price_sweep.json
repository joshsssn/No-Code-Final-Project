      {
        "id": "a834936b-25ab-459c-9871-b4e7fdf8eb38",
        "name": "Validate punchline",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1648,
          368
        ],
        "parameters": {
          "jsCode": "// Rejette une punchline vide ou avec un chiffre (template a la place) puis construit le ping de Razmo\nconst d = $('Decide').first().json;\nconst T = [\"Razmo a vu. Razmo content. Tu y vas ?\", \"Razmo bouge pas, mais toi tu peux filer à la pompe.\", \"Razmo l'avait dit : la patience paie toujours.\", \"Razmo a attendu longtemps. Ça valait le coup.\", \"Razmo te garde la place, va faire le plein tranquille.\", \"Le prix a baissé, Razmo sourit dans sa moustache.\", \"Razmo a l'œil sur les pompes. Et là, c'est le moment.\", \"Razmo dit : c'est le moment, mais sans courir.\", \"Razmo est fier de toi. Et un peu de lui aussi.\", \"Razmo a senti l'odeur de la bonne affaire.\"];\nlet p = String($input.first().json.text || '').trim().replace(/\\s+/g, ' ').replace(/^[\"«\\s]+|[\"»\\s]+$/g, '');\nconst fromLlm = !!p && !/\\d/.test(p) && p.length <= 200;\nif (!fromLlm) p = T[Math.floor(Math.random() * T.length)];\nconst e = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst eur = n => Number(n).toFixed(3).replace(/0$/, '').replace('.', ',') + ' €';\nconst b = d.best || {};\nconst text = '🐀 <b>Razmo a vu !</b> ' + e(d.fuel) + ' à <b>' + eur(d.min) + '</b> chez ' + e(b.name) + '.\\nTon seuil : ' + eur(d.threshold) + ' (' + e(d.place_label) + ').\\n\\n<i>' + e(p) + '</i>';\nreturn [{ json: { chat_id: d.chat_id, text, punchline: p, from_llm: fromLlm } }];"
        }
      },
