      {
        "id": "10a849e7-194d-4abf-ab40-5e2c52e6005b",
        "name": "Rapido menu",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          704,
          160
        ],
        "parameters": {
          "jsCode": "// Menu statique de Rapido (0 appel LLM)\nconst q = $input.first().json;\nconst text = '🐀 <b>Rapido, vite vite vite !</b>\\n\\n'\n  + '<b>/plein &lt;lieu&gt; &lt;carburant&gt;</b> : les 5 pompes les moins chères autour.\\n'\n  + 'Exemple : <code>/plein Créteil gazole</code>\\n'\n  + 'Carburants : gazole, sp95, e10, sp98, e85, gplc.\\n\\n'\n  + 'Ou écris-moi en texte libre : « je vais à Lyon demain, je fais le plein où ? »\\n\\n'\n  + 'Une alerte de prix ? C\\'est Razmo qui surveille : @razmo_carbu_bot';\nreturn [{ json: { chat_id: q.chat_id, text } }];"
        }
      },
