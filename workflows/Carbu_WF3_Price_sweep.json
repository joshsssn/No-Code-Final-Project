      {
        "id": "9d8081b3-ef44-4285-bf35-a82c9cf213c5",
        "name": "Decide",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          944,
          480
        ],
        "parameters": {
          "jsCode": "// Hysteresis : fire si min <= seuil et alerte armee ; rearm si min > seuil + 0.02 et desarmee ; sinon skip\nconst a = $('Loop Over Items').first().json;\nconst r = $input.first().json;\nconst t = Number(a.threshold);\nlet decision = 'skip';\nif (r.ok && r.min <= t && a.armed === true) decision = 'fire';\nelse if (r.ok && r.min > t + 0.02 && a.armed !== true) decision = 'rearm';\nreturn [{ json: { decision, alert_id: a.id, chat_id: a.chat_id, fuel: a.fuel, threshold: t, place_label: r.place_label || a.place_label,\n  ok: !!r.ok, min: r.min, avg: r.avg, station_count: r.station_count, best: r.ok ? r.stations[0] : null } }];"
        }
      },
