      {
        "id": "c1c4ed27-f55e-4d53-bf37-fb60de418eeb",
        "name": "Hand over to Razmo",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1648,
          352
        ],
        "parameters": {
          "jsCode": "// Ajoute le lien profond vers Razmo, seuil = meilleur prix - 3 centimes\nconst a = $('Format plein answer').first().json;\nconst user = $input.first().json.value || 'razmo_carbu_bot';\nif (!a.ok) return [{ json: { chat_id: a.chat_id, text: a.text } }];\nconst cents = Math.round((a.min - 0.03) * 100);\nconst link = 'https://t.me/' + user + '?start=a_' + a.fuel + '_' + cents + '_' + a.postcode;\nconst seuil = (cents / 100).toFixed(2).replace('.', ',');\nreturn [{ json: { chat_id: a.chat_id, text: a.text + '\\n\\n🐀 Razmo peut surveiller pour toi (alerte sous ' + seuil + ' €) : <a href=\"' + link + '\">clique ici</a>' } }];"
        }
      },
      {
        "id": "cc6e381e-abc2-46ec-acc9-079e07e44956",
        "name": "Split for Telegram",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1888,
          400
        ],
        "parameters": {
          "jsCode": "// Decoupe chaque message en morceaux de moins de 4000 caracteres (limite Telegram)\nconst out = [];\nfor (const it of $input.all()) {\n  let rest = String(it.json.text || '');\n  while (rest.length > 3900) {\n    let cut = rest.lastIndexOf('\\n', 3900);\n    if (cut < 1000) cut = 3900;\n    out.push({ json: { chat_id: it.json.chat_id, text: rest.slice(0, cut) } });\n    rest = rest.slice(cut);\n  }\n  if (rest.trim()) out.push({ json: { chat_id: it.json.chat_id, text: rest } });\n}\nreturn out;"
        }
      },
      {
        "id": "cfffd262-34d4-4f49-93db-e3423875138d",
        "name": "Shape agent reply",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1280,
          624
        ],
        "parameters": {
          "jsCode": "// Nettoie la reponse de l'agent pour Telegram (HTML echappe, gras Markdown converti)\nconst q = $('Read the message').first().json;\nlet t = String($input.first().json.output || '').trim();\nt = t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\\*\\*(.+?)\\*\\*/g, '<b>$1</b>');\nif (!t) t = \"Euh, j'ai perdu le fil. Redis-moi, vite !\";\nreturn [{ json: { chat_id: q.chat_id, text: t } }];"
        }
      },
