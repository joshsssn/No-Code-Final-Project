      {
        "id": "72b8ca91-2fa0-44ae-8359-819eea78ee03",
        "name": "Sweep summary",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          720,
          240
        ],
        "parameters": {
          "jsCode": "// Resume du sweep : alertes verifiees, pings envoyes, alertes rearmees\nconst runs = name => { let n = 0; for (let i = 0; i < 1000; i++) { let it = []; try { it = $(name).all(0, i); } catch (e) { break; } if (!it || !it.length) break; n++; } return n; };\nreturn [{ json: { checked: runs('Decide'), fired: runs('Mark alert fired'), rearmed: runs('Rearm alert') } }];"
        }
      },
