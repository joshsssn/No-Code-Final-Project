      {
        "id": "a3a9033d-241e-4c62-b247-a48ce81da349",
        "name": "Format plein answer",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1200,
          352
        ],
        "parameters": {
          "jsCode": "// Met en forme la reponse /plein dans la voix de Rapido (tous les prix viennent de WF2)\nconst r = $input.first().json;\nconst q = $('Read the message').first().json;\nconst e = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst eur = n => Number(n).toFixed(3).replace(/0$/, '').replace('.', ',') + ' €';\nif (!r.ok) {\n  const msgs = {\n    place_not_found: 'Connais pas « ' + e(q.place) + ' » ! Une ville ou un code postal, vite !',\n    unknown_fuel: 'Carburant inconnu ! gazole, sp95, e10, sp98, e85 ou gplc. Allez !',\n    no_station: 'Aucune pompe à moins de 10 km pour ce carburant. Faut bouger !',\n    api_down: 'Les pompes répondent pas. Réessaie dans une minute, je file !'\n  };\n  return [{ json: { ok: false, chat_id: q.chat_id, text: msgs[r.reason] || msgs.api_down } }];\n}\nconst lines = r.stations.map((s, i) => (i + 1) + '. <b>' + eur(s.price) + '</b> · ' + e(s.name));\nconst text = 'Vite vite vite ! ' + r.stations.length + ' pompes à moins de ' + r.radius_km + ' km de ' + e(r.place_label) + ' (' + e(r.fuel) + ').\\n\\n'\n  + lines.join('\\n') + '\\n\\nLa moins chère : <b>' + eur(r.min) + '</b>. Moyenne ' + eur(r.avg) + '. Allez, file !';\nreturn [{ json: { ok: true, chat_id: q.chat_id, text, fuel: r.fuel, min: r.min, postcode: r.postcode } }];"
        }
      },
      {
        "id": "2e8d7b54-9399-4c0e-94c9-3819a56292e9",
        "name": "Plein usage",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          960,
          560
        ],
        "parameters": {
          "jsCode": "// Message d'usage quand /plein est incomplet\nconst q = $input.first().json;\nlet text = 'Hé, trop vite même pour moi ! Dis-moi où et quoi : <code>/plein Créteil gazole</code>';\nif (q.place && !q.fuel) text = 'Quel carburant ? gazole, sp95, e10, sp98, e85 ou gplc. Exemple : <code>/plein Créteil gazole</code>';\nreturn [{ json: { chat_id: q.chat_id, text } }];"
        }
