      {
        "id": "8e6f8048-7c59-4997-b0b5-e9e6797fbb64",
        "name": "Read the message",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          224,
          400
        ],
        "parameters": {
          "jsCode": "// Lit le message Telegram : chat_id, commande, lieu et carburant normalises (synonymes)\nconst MAP = { gazole: 'gazole', diesel: 'gazole', gasoil: 'gazole', gazoil: 'gazole', sp95: 'sp95', '95': 'sp95', e10: 'e10', sp95e10: 'e10', sp98: 'sp98', '98': 'sp98', e85: 'e85', gplc: 'gplc', gpl: 'gplc' };\nconst norm = w => MAP[String(w || '').toLowerCase().replace(/[\\s-]/g, '')] || '';\nconst m = $input.first().json.message || {};\nconst text = String(m.text || '').trim();\nconst chat_id = String((m.chat && m.chat.id) || '');\nconst cmd = ((text.match(/^\\/(\\w+)/) || [])[1] || '').toLowerCase();\nlet command = 'free', place = '', fuel = '';\nif (!text || cmd === 'start' || cmd === 'help') command = 'help';\nelse if (cmd === 'plein') {\n  command = 'plein';\n  const w = text.replace(/^\\/\\S+\\s*/, '').split(/\\s+/).filter(Boolean);\n  if (w.length && norm(w[w.length - 1])) { fuel = norm(w.pop()); }\n  else if (w.length && norm(w[0])) { fuel = norm(w.shift()); }\n  place = w.join(' ');\n} else if (cmd) command = 'help';\nreturn [{ json: { chat_id, text, command, place, fuel, valid: command !== 'plein' || !!(place && fuel) } }];"
        }
      },
