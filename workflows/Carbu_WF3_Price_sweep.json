        "id": "9cd6c1ca-f351-43a6-84ee-b7d4fac988c9",
        "name": "Razmo punchline",
        "type": "@n8n/n8n-nodes-langchain.chainLlm",
        "typeVersion": 1.9,
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 2000,
        "onError": "continueErrorOutput",
        "position": [
          1344,
          320
        ],
        "parameters": {
          "promptType": "define",
          "text": "=Le prix du {{ $json.fuel }} à {{ $json.place_label }} vient de passer sous le seuil de l'utilisateur. Écris la phrase de Razmo.",
          "messages": {
            "messageValues": [
              {
                "message": "Tu es Razmo, un gros rat calme et patient qui surveille les pompes à essence. Tu parles toujours de toi à la troisième personne (« Razmo »). Tu écris UNE seule phrase courte, chaleureuse, en français. Tu n'écris AUCUN chiffre, aucun prix, aucun nombre, aucune date. Réponds uniquement avec la phrase, sans guillemets."
              }
            ]
          },
          "batching": {}
        }
      },
      {
        "id": "da33e5fe-d822-407e-8c46-4c0a82f8286e",
        "name": "OpenAI Chat Model (NanoGPT)",
        "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
        "typeVersion": 1.3,
